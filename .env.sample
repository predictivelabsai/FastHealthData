# --- FastHealthData --------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored — never commit secrets.

FASTHEALTHDATA_ADMIN_EMAIL=admin@fasthealthdata.example
FASTHEALTHDATA_ADMIN_PASSWORD=FastHealthData2026$
FASTHEALTHDATA_SECRET=
FASTHEALTHDATA_PORT=5013
FASTHEALTHDATA_ENV_LABEL=FastHealthData
# Blank => ./fasthealthdata.sqlite. In Docker point at the mounted volume.
FASTHEALTHDATA_DB=
# Salt for the pseudonymisation stub (use a real HSM/KMS key in production).
FASTHEALTHDATA_PSEUDO_SALT=

# --- AI assistant ----------------------------------------------------------
# Free-form chat uses one provider; slash-commands (/projects, /access …) need no key.
#   MODEL_PROVIDER: xai | openai | anthropic | google
MODEL_PROVIDER=xai
MODEL_NAME=grok-4-1-fast-reasoning
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
